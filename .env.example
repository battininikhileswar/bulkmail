# ==============================================================================
# BulkMail Configuration Example
# ==============================================================================

# --- Backend Settings ---
# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# OAuth Redirect URI
# Local: http://localhost:8000/api/auth/callback
# Vercel: https://bulkmail-backend-nine.vercel.app/api/auth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Frontend URL (for CORS & post-auth redirects)
# Local: http://localhost:5173
# Vercel: https://bulkmail-frontend-cyan.vercel.app
FRONTEND_URL=http://localhost:5173

# Session Encryption Secret
SESSION_SECRET=change-this-to-a-secure-random-64-character-hex-string

# AI Provider API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Frontend Settings ---
# Backend API Base URL
VITE_API_URL=http://localhost:8000/api
